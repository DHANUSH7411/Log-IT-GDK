# =======================================================
# Log IT! — by GDK — Server Configuration
# =======================================================

# Port for Express API server
# NOTE: macOS Monterey+ uses port 5000 for AirPlay, so we use 5001
PORT=5001

# Client Application URL (for CORS and cookies)
CLIENT_URL=http://localhost:5173

# Secret for session signing (change to a random string in production)
SESSION_SECRET=moviebox_super_secret_session_key_2026_cinematic

# MySQL Database Configuration
DB_HOST=127.0.0.1
# Use 3307 for the project's local MySQL instance, or 3306 for system MySQL
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=moviebox_db

# TMDB (The Movie Database) API Configuration
# Get your free API key at: https://www.themoviedb.org/settings/api
# Use either TMDB_API_KEY (v3 auth key) or TMDB_ACCESS_TOKEN (v4 Bearer token)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
